{
  "name": "privateai-launcher",
  "version": "1.1.0",
  "author": "https://github.com/tanvir-commits/privateai-launcher",
  "private": true,
  "type": "module",
  "description": "PrivateAI Launcher — Windows control panel for local Ollama, Open WebUI, and ComfyUI",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/_run-all-smoke.ps1",
    "test:all": "npm run typecheck && npm run test && npm run test:ps",
    "verify:stack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/verify-local-stack.ps1",
    "verify:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/verify-local-stack.ps1 -StartDev",
    "verify:full": "npm run verify:stack && npm test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json",
    "dist:win:zip": "npm run dist:win && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/zip-windows-portable.ps1",
    "dist:win:clean": "npm run build && electron-builder --win --config electron-builder.json --config.directories.output=installer-out",
    "icon:from-apng": "node scripts/apng-to-ico.mjs",
    "shortcut:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/create-desktop-shortcut.ps1",
    "go": "node scripts/task.mjs",
    "go:dev": "node scripts/task.mjs dev",
    "go:test": "node scripts/task.mjs test:all",
    "go:verify": "node scripts/task.mjs verify:full"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.6",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
